{
  "name": "america-my-face",
  "author": "Ky Decker <hi@ky.fyi> (https://ky.fyi/)",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  },
  "nano-staged": {
    "*.{astro,cjs,css,js,json,jsonc,jsx,mjs,ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "astro": "^6.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "nano-staged": "^1.0.2",
    "simple-git-hooks": "^2.13.1"
  }
}
